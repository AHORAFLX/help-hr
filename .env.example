# La connection string se puede pasar tambien por linea de comandos con
#   python migrate.py --connection-string "..."
# que tiene prioridad sobre lo que haya aqui.
#
# Autenticacion integrada de Windows (Trusted_Connection=yes): no hay password
# que guardar aqui. Si tu entorno usa usuario y contrasena de SQL Server,
# sustituye Trusted_Connection=yes por UID=<usuario>;PWD=<contrasena>.
AUTHOR_ARTICLES_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};Server=SERVIDOR;Database=BASE_DE_DATOS;Trusted_Connection=yes;TrustServerCertificate=yes;
